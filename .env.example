# dossier -- per-machine settings. Copy to `.env` (git-ignored) and fill in.
#
# Only WHERE a model is served and HOW to authenticate live here. WHICH model
# answers is `model:` in pipeline.yaml, and it is part of every cache key;
# nothing in this file is (spec 009, R9.2). A variable already set in your shell
# wins over this file, and only DOSSIER_ variables are read from it (R9.11).

# --- Default: a local OpenWebUI ----------------------------------------------
# pipeline.yaml:   model: gemini:gemini-3.5-flash-lite
#
# OpenWebUI speaks the OpenAI API under /api and passes Ollama through under
# /ollama. Both take OpenWebUI's own API key (Settings > Account > API keys).

DOSSIER_GEMINI_URL=http://localhost:8080/api
DOSSIER_GEMINI_API_KEY=

# Ollama models behind the same OpenWebUI, such as qwen3:1.7b. An Ollama model
# is pinned by its full digest (R9.3), from `ollama show` or /ollama/api/tags:
#   model: ollama:qwen3:1.7b@sha256:<64 hex characters>
DOSSIER_OLLAMA_URL=http://localhost:8080/ollama
DOSSIER_OLLAMA_API_KEY=

# --- Direct access: uncomment to bypass OpenWebUI ---------------------------
# Changing only these never changes a cache key (R5.3 row 4).

# Gemini straight from Google. Also the default when DOSSIER_GEMINI_URL is unset.
# DOSSIER_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DOSSIER_GEMINI_API_KEY=

# Ollama on this machine. Also the default when DOSSIER_OLLAMA_URL is unset.
# DOSSIER_OLLAMA_URL=http://localhost:11434
# DOSSIER_OLLAMA_API_KEY=

# OpenAI.   model: openai:gpt-4o-2024-08-06
# DOSSIER_OPENAI_URL=https://api.openai.com/v1
# DOSSIER_OPENAI_API_KEY=

# Anthropic.   model: anthropic:claude-sonnet-4-5-20250929
# DOSSIER_ANTHROPIC_URL=https://api.anthropic.com
# DOSSIER_ANTHROPIC_API_KEY=

# A model served by vLLM.   model: hf:<org>/<repo>@<40-character commit>
# There is no default: a run that needs it stops, naming this variable (R9.2).
# DOSSIER_HF_URL=http://gpu-01:8000/v1
# DOSSIER_HF_API_KEY=
