# dossier -- per-machine settings. Copy to `.env` (git-ignored) and fill in.
#
# Only WHERE a model is served and HOW to authenticate live here. WHICH model
# answers is `model:` in pipeline.yaml, and it is part of every cache key;
# nothing in this file is (spec 009, R9.2). A variable already set in your shell
# wins over this file, and only DOSSIER_ variables are read from it (R9.11).

# --- Default: a local OpenWebUI ----------------------------------------------
# pipeline.yaml:   model: gemini:gemini-3.5-flash-lite
#
# OpenWebUI speaks the OpenAI API under /api and passes Ollama through under
# /ollama. Both take OpenWebUI's own API key (Settings > Account > API keys).

DOSSIER_GEMINI_URL=http://localhost:8080/api
DOSSIER_GEMINI_API_KEY=

# OpenAI-served models behind the same OpenWebUI, on the same /api route. An
# OpenAI model is pinned by a dated snapshot or by a stable code (R9.14):
#   model: openai:gpt-5.4-mini
DOSSIER_OPENAI_URL=http://localhost:8080/api
DOSSIER_OPENAI_API_KEY=

# Ollama models behind the same OpenWebUI, such as qwen3:1.7b. An Ollama model
# is pinned by its full digest (R9.3), from `ollama show` or /ollama/api/tags:
#   model: ollama:qwen3:1.7b@sha256:<64 hex characters>
DOSSIER_OLLAMA_URL=http://localhost:8080/ollama
DOSSIER_OLLAMA_API_KEY=

# --- Direct access: uncomment to bypass OpenWebUI ---------------------------
# Changing only these never changes a cache key (R5.3 row 4).

# Gemini straight from Google. Also the default when DOSSIER_GEMINI_URL is unset.
# DOSSIER_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DOSSIER_GEMINI_API_KEY=

# Ollama on this machine. Also the default when DOSSIER_OLLAMA_URL is unset.
# DOSSIER_OLLAMA_URL=http://localhost:11434
# DOSSIER_OLLAMA_API_KEY=

# OpenAI straight from OpenAI. Also the default when DOSSIER_OPENAI_URL is unset.
#   model: openai:gpt-5.4-mini, or openai:gpt-4o-2024-08-06
# DOSSIER_OPENAI_URL=https://api.openai.com/v1
# DOSSIER_OPENAI_API_KEY=

# Anthropic.   model: anthropic:claude-sonnet-4-5-20250929
# DOSSIER_ANTHROPIC_URL=https://api.anthropic.com/v1
# DOSSIER_ANTHROPIC_API_KEY=

# A model served by vLLM.   model: hf:<org>/<repo>@<40-character commit>
# There is no default: a run that needs it stops, naming this variable (R9.2).
# DOSSIER_HF_URL=http://gpu-01:8000/v1
# DOSSIER_HF_API_KEY=

# --- Source credentials (spec 001) ------------------------------------------
# A source names its credential's variable in sources.yaml and never the value
# (R1.8): `token_env: DOSSIER_JIRA_TOKEN`. Only DOSSIER_ variables are read from
# this file, so a credential kept here is named with the prefix.
#
# Jira Data Center: a personal access token, sent as `Authorization: Bearer`.
# DOSSIER_JIRA_TOKEN=
#
# Jira Cloud, or Data Center with a username and password: name the user as
# well, `user_env: DOSSIER_JIRA_USER`, and the pair is sent as HTTP Basic
# (R1.12). A Cloud source also says `deployment: cloud` (R1.13).
# DOSSIER_JIRA_USER=

# --- MLflow tracking (spec 010) ---------------------------------------------
# Off unless DOSSIER_MLFLOW_ENABLED is exactly `true`. MLflow's own variables
# (MLFLOW_TRACKING_URI, MLFLOW_EXPERIMENT_NAME) are not read (R10.1). Tracking
# observes a run and is never an input to one: switching it on changes no
# manifest, key or artifact (R10.4).
#
# The URI has no default in code (R10.1). This is the value it would have had.

DOSSIER_MLFLOW_ENABLED=false
DOSSIER_MLFLOW_TRACKING_URI=http://localhost:5000

# Where records land: one experiment per pipeline and command kind. `{kind}` is
# sync, convert, run, eval or calibrate; `{gold}` renders the gold set's name
# and exists only for eval and calibrate (R10.2). A per-kind variable wins over
# the shared one.
# DOSSIER_MLFLOW_EXPERIMENT=dossier-audit/{pipeline}/{kind}
# DOSSIER_MLFLOW_EXPERIMENT_EVAL=dossier-audit/{pipeline}/eval/{gold}
# DOSSIER_MLFLOW_EXPERIMENT_CALIBRATE=dossier-audit/{pipeline}/calibrate/{gold}

# What an LLM span carries: `full` (the rendered prompt and the reply) or
# `hashes` (the template, input and key hashes, and no text). Anything else
# is refused before any work (R10.8).
# DOSSIER_MLFLOW_CAPTURE=full
