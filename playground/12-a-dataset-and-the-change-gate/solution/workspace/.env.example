# Exercise 12's additions to exercise 08's `.env`. The first two are exercise 08's;
# the two templates put an eval and a comparison in experiments of their own, so a
# delta never shares a column with an accuracy (R10.2, R11.8).
DOSSIER_MLFLOW_ENABLED=true
DOSSIER_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
DOSSIER_MLFLOW_EXPERIMENT_EVAL=dossier-audit/{pipeline}/eval/{gold}
DOSSIER_MLFLOW_EXPERIMENT_COMPARE=dossier-audit/{pipeline}/compare/{gold}
