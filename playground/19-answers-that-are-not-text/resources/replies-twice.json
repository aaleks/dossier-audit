            "source": {
              "document": "PLAY-GLOBEX-2023.md",
              "span": "This Agreement shall not renew automatically"
            }
          },
          {
            "field": "notice_period",
            "value": "3 months",
            "source": {
              "document": "PLAY-GLOBEX-2023.md",
              "span": "three (3) months' written notice"
            }
          },
          {
            "field": "notice_period",
            "value": "90 days",
            "source": {
              "document": "PLAY-GLOBEX-2023.md",
              "span": "three (3) months' written notice"
            }
          },
          {
            "field": "sites",
            "value": "Basel",
            "source": {
              "document": "PLAY-GLOBEX-2023.md",
              "span": "warehouse in Basel"
            }
          }
        ]
      }
    },
    {
      "comment": "ACME: as in replies.json",
      "match": [
        "# Supply agreement: ACME"
      ],
      "reply": {
        "document": "PLAY-ACME-2024.md",
        "fields": [
          {
            "field": "auto_renew",
            "value": true,
            "source": {
              "document": "PLAY-ACME-2024.md",
              "span": "renews automatically for successive one-year terms"
            }
          },
          {
            "field": "notice_period",
            "value": "90 days",
            "source": {
              "document": "PLAY-ACME-2024.md",
              "span": "ninety (90) days' written notice"
            }
          },
          {
            "field": "sites",
            "value": "Zurich",
            "source": {
              "document": "PLAY-ACME-2024.md",
              "span": "sites in Zurich"
            }
          },
          {
            "field": "sites",
            "value": "Basel",
            "source": {
              "document": "PLAY-ACME-2024.md",
              "span": "Zurich, Basel and Geneva"
            }
          }
        ]
      }
    },
    {
      "comment": "INITECH: as before",
      "match": [
        "# Services agreement: Initech"
      ],
      "reply": {
        "document": "PLAY-INITECH-2025.md",
        "fields": [
          {
            "field": "auto_renew",
            "value": null,
            "reason": "the agreement says nothing about renewal"
          },
          {
            "field": "notice_period",
            "value": null,
            "reason": "the agreement states no notice period"
          },
          {
            "field": "sites",
            "value": "Zurich",
            "source": {
