{
  "rules": [
    {
      "comment": "GLOBEX's retry: the refusal named notice_period, and this time it is answered once. First, because first match wins",
      "match": [
        "# Logistics agreement: Globex",
        "<validation_error>"
      ],
      "reply": {
        "document": "PLAY-GLOBEX-2023.md",
        "fields": [
          {
            "field": "auto_renew",
            "value": false,
            "source": {
              "document": "PLAY-GLOBEX-2023.md",
              "span": "This Agreement shall not renew automatically"
            }
          },
          {
            "field": "notice_period",
            "value": "3 months",
            "source": {
              "document": "PLAY-GLOBEX-2023.md",
              "span": "three (3) months' written notice"
            }
          },
          {
            "field": "sites",
            "value": "Basel",
            "source": {
              "document": "PLAY-GLOBEX-2023.md",
              "span": "warehouse in Basel"
            }
          }
        ]
      }
    },
    {
      "comment": "GLOBEX's first answer: notice_period twice, one each way. Two answers to one question (R6.24)",
      "match": [
        "# Logistics agreement: Globex"
      ],
      "reply": {
        "document": "PLAY-GLOBEX-2023.md",
        "fields": [
          {
            "field": "auto_renew",
