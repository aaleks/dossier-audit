# Copy this to `.env` in your workspace, and fill in the two Jira values.
# `.env` is git-ignored everywhere in this repository, which is why this file
# has a different name.
#
# Three things live here and nothing else: where a model is served, where Jira
# is, and the credentials for both. None of them is in a cache key (R9.2) --
# WHICH model answers is `model:` in pipeline.yaml, and WHAT is audited is
# `sources.yaml`. That split is what lets this exercise use a stub model against
# a real Jira without changing a single key.
#
# Only DOSSIER_ variables are read from this file (R9.11 row 4). `JIRA_TOKEN=`
# written here is invisible to dossier, and the connector says so by name rather
# than failing with a 401 (R1.8 row 6). A variable already set in your shell
# wins over this file.

# --- Jira -------------------------------------------------------------------
# The administrator account you created in the setup wizard. Naming a user
# beside the token is what makes the header Basic rather than Bearer (R1.12).
# `seed_jira.py` reads these same two variables, so there is one place to fill.
DOSSIER_JIRA_USER=admin
DOSSIER_JIRA_TOKEN=

# Where seed_jira.py looks for Jira. `dossier` does not read this -- the base
# URL it uses is `url:` in sources.yaml, because what is audited is
# configuration and not per-machine setup.
DOSSIER_JIRA_URL=http://localhost:8080

# --- the model --------------------------------------------------------------
# The playground's stub, started from toolkit/stub_model.py. Point these at a
# real endpoint instead and expect different field values -- the Jira half of
# this exercise is unaffected either way.
DOSSIER_OPENAI_URL=http://127.0.0.1:8099/api
DOSSIER_OPENAI_API_KEY=stub
