# Copy this to `.env` in your workspace. `.env` is git-ignored everywhere in this
# repository, which is why this file has a different name.
#
# Only the model lives here. Neither Confluence in this exercise asks for a
# credential, so there is nothing for `token_env` or `user_env` to name, and
# `sources.yaml` names neither (R1.21 row 3).
#
# A Confluence that does ask would be named the way a Jira is: `token_env:
# DOSSIER_CONFLUENCE_TOKEN` in sources.yaml, and its value here. Only DOSSIER_
# variables are read from this file (R9.11 row 4).

DOSSIER_OPENAI_URL=http://127.0.0.1:8099/api
DOSSIER_OPENAI_API_KEY=stub
