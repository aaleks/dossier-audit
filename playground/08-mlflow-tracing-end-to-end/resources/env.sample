# The workspace `.env` for this exercise. Copy it to `.env` in your workspace.
#
# Tracking is off unless DOSSIER_MLFLOW_ENABLED is exactly `true` (R10.1), and
# the URI has no default in code -- this is the value it would have had.
#
# MLflow's own variables are deliberately NOT read: a MLFLOW_TRACKING_URI left in
# a shell from another project must not start recording your audit somewhere you
# did not choose. See task 6 for the one place that decision costs something.

DOSSIER_OPENAI_URL=http://127.0.0.1:8099/api
DOSSIER_OPENAI_API_KEY=stub

DOSSIER_MLFLOW_ENABLED=true
DOSSIER_MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# What an LLM span carries: `full` (the rendered prompt and the reply) or
# `hashes` (the template, input and key hashes, and no text). Anything else is
# refused before any work (R10.8).
DOSSIER_MLFLOW_CAPTURE=full

# One experiment per pipeline and command kind. `{kind}` is sync, convert, run,
# eval or calibrate; `{gold}` exists only for eval and calibrate. A per-kind
# variable wins over the shared one (R10.2).
# DOSSIER_MLFLOW_EXPERIMENT=dossier-audit/{pipeline}/{kind}
# DOSSIER_MLFLOW_EXPERIMENT_EVAL=dossier-audit/{pipeline}/eval/{gold}
