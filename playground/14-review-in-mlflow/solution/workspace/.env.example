# Exercise 14's `.env`. Copy it to `.env` in the workspace.
#
# Its own server and its own stub port, so the review queue holds this
# exercise's traces and nobody else's: `dossier review pull` reads every trace
# in the pipeline's run experiment, and exercises 08 and 13 left runs of
# `incident-audit` in theirs.
#
# `full` is the setting review needs. The trace list's Request and Response
# columns show the document and the answer under `full`, and a hash of each
# under `hashes` -- which a reviewer cannot read, and so cannot judge (R15.1,
# R10.8). It is a decision about the server, made by whoever runs it.
DOSSIER_OPENAI_URL=http://127.0.0.1:8114/api
DOSSIER_OPENAI_API_KEY=stub
DOSSIER_MLFLOW_ENABLED=true
DOSSIER_MLFLOW_TRACKING_URI=http://127.0.0.1:5114
DOSSIER_MLFLOW_CAPTURE=full
