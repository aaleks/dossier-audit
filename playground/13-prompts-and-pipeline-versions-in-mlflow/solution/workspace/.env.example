# Exercise 13's `.env`. Copy it to `.env` in the workspace.
#
# Its own server and its own stub port, so the exercise runs beside any earlier
# one: a prompt name is global within a server (R14.8), and a registry another
# workspace already published `incident-audit.extract` into would move every
# version number this exercise shows.
#
# The two templates are exercise 12's: an eval and a comparison each in an
# experiment of its own, so a delta never shares a column with an accuracy
# (R10.2, R11.8).
DOSSIER_OPENAI_URL=http://127.0.0.1:8113/api
DOSSIER_OPENAI_API_KEY=stub
DOSSIER_MLFLOW_ENABLED=true
DOSSIER_MLFLOW_TRACKING_URI=http://127.0.0.1:5113
DOSSIER_MLFLOW_EXPERIMENT_EVAL=dossier-audit/{pipeline}/eval/{gold}
DOSSIER_MLFLOW_EXPERIMENT_COMPARE=dossier-audit/{pipeline}/compare/{gold}
