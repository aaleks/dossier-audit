# Copy this to `.env` in your workspace. `.env` is git-ignored everywhere in this
# repository, which is why this file has a different name.
#
# Only WHERE a model is served and HOW to authenticate live here. WHICH model
# answers is `model:` in pipeline.yaml, and it is the half that is in every cache
# key (R9.2). That split is what lets the playground's stub stand in for a real
# endpoint without changing a single key.
#
# A variable already set in your shell wins over this file, and only DOSSIER_
# variables are read from it (R9.11).

DOSSIER_OPENAI_URL=http://127.0.0.1:8099/api
DOSSIER_OPENAI_API_KEY=stub
